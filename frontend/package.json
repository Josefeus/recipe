{
  "name": "recipe-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data:sync": "node ../scripts/sync-cooklikehoc.mjs",
    "data:check": "node ../scripts/sync-cooklikehoc.mjs --check",
    "data:build": "node scripts/build-recipes.mjs",
    "test:scripts": "node --test \"../scripts/**/*.test.mjs\"",
    "dev": "node scripts/build-recipes.mjs && vite",
    "build": "node scripts/build-recipes.mjs && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "pinia": "^2.2.4",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.5",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.13.0",
    "eslint-plugin-vue": "^9.30.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.3",
    "vue-tsc": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
